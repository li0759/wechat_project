<!-- 入会审批骨架：全部使用待审批卡片结构 -->
<view class="sk-tl-root cap-tl-root">
  <view class="tl-modal-header">
    <text class="tl-modal-h-title">入会审批</text>
    <t-skeleton
      animation="gradient"
      rowCol="{{[{ width: '96rpx', height: '24rpx', borderRadius: '6rpx' }]}}"
    />
  </view>

  <view class="tl-modal-scroll">
    <view
      wx:for="{{rows}}"
      wx:key="index"
      wx:for-index="idx"
      wx:for-item="item"
      class="tl-modal-row"
    >
      <view class="tl-modal-left">
        <t-skeleton
          animation="gradient"
          rowCol="{{[{ width: item.dateW, height: '22rpx', borderRadius: '6rpx' }]}}"
        />
        <t-skeleton
          animation="gradient"
          rowCol="{{[{ width: item.timeW, height: '20rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}"
        />
      </view>

      <view class="tl-modal-rail">
        <view class="tl-dot"></view>
        <view class="tl-vline" wx:if="{{idx < rows.length - 1}}"></view>
      </view>

      <view class="tl-modal-main tl-modal-main--milestone-pending">
        <view class="cap-app-pending-card">
          <view class="cap-app-pending-actions">
            <t-skeleton
              animation="gradient"
              rowCol="{{[{ width: '128rpx', height: '56rpx', borderRadius: '8rpx' }]}}"
            />
            <t-skeleton
              animation="gradient"
              rowCol="{{[{ width: '128rpx', height: '56rpx', borderRadius: '8rpx' }]}}"
            />
          </view>
          <t-skeleton
            animation="gradient"
            rowCol="{{[{ width: item.statusW, height: '30rpx', borderRadius: '8rpx' }]}}"
          />
          <view class="tl-op-row cap-app-pending-row">
            <t-skeleton
              animation="gradient"
              rowCol="{{[{ width: '64rpx', height: '64rpx', borderRadius: '50%' }]}}"
            />
            <view class="tl-op-meta">
              <t-skeleton
                animation="gradient"
                rowCol="{{[{ width: item.nameW, height: '28rpx', borderRadius: '8rpx' }]}}"
              />
              <t-skeleton
                animation="gradient"
                rowCol="{{[{ width: item.sub1W, height: '24rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}"
              />
              <t-skeleton
                animation="gradient"
                rowCol="{{[{ width: item.sub2W, height: '24rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}"
              />
              <t-skeleton
                animation="gradient"
                rowCol="{{[{ width: item.sub3W, height: '24rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}"
              />
              <t-skeleton
                animation="gradient"
                rowCol="{{[{ width: item.sub4W, height: '24rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}"
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="tl-modal-end-sk">
      <t-skeleton
        animation="gradient"
        rowCol="{{[{ width: '140rpx', height: '24rpx', borderRadius: '6rpx' }]}}"
      />
    </view>
    <view class="tl-modal-footer-space" />
  </view>
</view>

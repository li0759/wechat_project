<!-- packageProfile/components/user-info-panel/index.wxml -->
<view class="user-info-panel">
  <scroll-view scroll-y="{{true}}" class="panel-scroll">
    <view wx:if="{{loading}}" class="loading-container">
      <t-loading size="24px" theme="circular" />
      <view class="loading-text">加载中...</view>
    </view>

    <view wx:elif="{{userInfo}}" class="user-info-container">
      <view class="avatar-section">
        <view
          wx:if="{{isCurrentUser && !hasAvatar}}"
          class="avatar-wrap avatar-wrap--editable"
          bindtap="handleGetAvatar"
        >
          <image class="avatar" src="{{default_avatar}}" mode="aspectFill" />
          <view class="avatar-overlay">
            <text class="avatar-overlay-text">点击授权获取</text>
          </view>
        </view>
        <view wx:else class="avatar-wrap">
          <image class="avatar" src="{{userInfo.avatar || default_avatar}}" mode="aspectFill" />
        </view>
        <view class="user-name">{{userInfo.username}}</view>
        <view class="user-role">{{userInfo.roles_join}}</view>
      </view>

      <view wx:if="{{isCurrentUser}}" class="sync-hint">
        <t-icon name="info-circle" size="14px" color="#999" />
        <text>姓名、部门、职位、性别、邮箱来自企业通讯录，约每小时自动同步</text>
      </view>

      <view class="info-section">
        <view class="info-item info-item--readonly">
          <view class="info-label">账号ID</view>
          <view class="info-value">{{userInfo.id}}</view>
        </view>

        <view class="info-item info-item--readonly">
          <view class="info-label">姓名</view>
          <view class="info-value-wrap">
            <view class="info-value">{{userInfo.username || '未设置'}}</view>
            <view class="readonly-tag">同步</view>
          </view>
        </view>

        <view class="info-item info-item--readonly">
          <view class="info-label">性别</view>
          <view class="info-value-wrap">
            <view class="info-value">{{userInfo.gender || '未设置'}}</view>
            <view class="readonly-tag">同步</view>
          </view>
        </view>

        <view class="info-item">
          <view class="info-label">手机号</view>
          <view
            wx:if="{{isCurrentUser && !hasPhone}}"
            class="info-value-wrap info-value-wrap--action"
            bindtap="handleGetPhone"
          >
            <view class="info-value info-value--placeholder">未设置</view>
            <view class="action-link">点击授权获取</view>
          </view>
          <view wx:else class="info-value-wrap">
            <view class="info-value">{{userInfo.phone || '未设置'}}</view>
          </view>
        </view>

        <view class="info-item info-item--readonly">
          <view class="info-label">邮箱</view>
          <view class="info-value-wrap">
            <view class="info-value">{{userInfo.email || '未设置'}}</view>
            <view class="readonly-tag">同步</view>
          </view>
        </view>

        <view class="info-item info-item--readonly">
          <view class="info-label">部门</view>
          <view class="info-value-wrap">
            <view class="info-value">{{userInfo.department || '未设置'}}</view>
            <view class="readonly-tag">同步</view>
          </view>
        </view>

        <view class="info-item info-item--readonly">
          <view class="info-label">职位</view>
          <view class="info-value-wrap">
            <view class="info-value">{{userInfo.position || '未设置'}}</view>
            <view class="readonly-tag">同步</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!isCurrentUser}}" class="view-only-hint">仅可查看，无法修改他人资料</view>
    </view>
  </scroll-view>
</view>

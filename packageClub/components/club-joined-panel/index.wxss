@import "../../../styles/panel-bottom-actions.wxss";
@import "../../../styles/panel-component-host.wxss";

panel-loading-transition {
  flex: 1 1 0;
  min-height: 0;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 协会已加入面板样式（与 event-joined-panel 一致） */
.club-joined-panel {
  position: relative;
  flex: 1 1 0;
  height: 100%;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fb;
  overflow: hidden;
  box-sizing: border-box;
}

/* 占满中间区域；内部再 flex 一列，scroll-view 用 flex+height:0 拿确定高度 */
.club-joined-main {
  flex: 1 1 0;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  /* 与全屏 sheet 顶圆角一致；父级 nested-popup-shell 也带圆角时双重裁剪无妨 */
  border-radius: 30rpx 30rpx 0 0;
}

/* 灰色蒙层样式 */
.disabled-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: all;
}

.disabled-overlay-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 20rpx;
  margin: 40rpx;
}

.disabled-overlay-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.disabled-overlay-desc {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* 主滚动：height:0 + flex:1 在小程序里常比 height:100% 更稳 */
.page-scroll {
  flex: 1 1 0;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  background: #fff;
}

/* 协会成员信息区 */
.club-info-section {
  background: #fff;
  padding: 32rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: stretch;
}

.member-block {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.member-block--self {
  padding: 24rpx 20rpx 22rpx;
  min-height: 0;
  background: linear-gradient(135deg, rgba(255, 107, 157, 0.08) 0%, #f7f8fa 55%);
  border: 1rpx solid rgba(255, 107, 157, 0.2);
}

.member-block-kicker {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

/* 当前用户：左资料约 60% + 右最近活动固定 40% */
.member-self-columns {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 0;
}

.member-self-left {
  flex: 0 0 60%;
  width: 60%;
  max-width: 60%;
  min-width: 0;
  padding-right: 16rpx;
  box-sizing: border-box;
}

.member-self-left--full {
  flex: 0 0 100%;
  width: 100%;
  max-width: 100%;
  padding-right: 0;
}

.member-self-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: flex-start;
}

.member-self-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.member-self-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.member-line {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.last-event-aside {
  flex: 0 0 40%;
  width: 40%;
  max-width: 40%;
  min-width: 0;
  padding-left: 16rpx;
  border-left: 1rpx solid rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  justify-content: center;
}

.last-event-kicker {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 0;
}

.last-event-body {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  align-items: center;
}

.last-event-body--aside {
  align-items: flex-start;
}

.last-event-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.last-event-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.last-event-time {
  font-size: 20rpx;
  color: #888;
}

/* 会长 / 副会长 / 理事 与 普通会员：8 列网格；会长 3 列×2 行，副会长/理事 2×2，会员 1×1 */
.members-unified-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 4rpx 0 0;
}

/* 会长：占 3 列 × 2 行（相对 1×1 会员格） */
.members-grid-cell--president {
  grid-column: span 3;
  grid-row: span 2;
  min-height: 0;
}

/* 副会长、理事：2×2 */
.members-grid-cell--2x2 {
  grid-column: span 2;
  grid-row: span 2;
  min-height: 0;
}

.members-grid-cell--1x1 {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 8rpx;
}

.officer-tile {
  height: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 12rpx 10rpx 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.officer-tile--president {
  min-height: 0;
  padding: 14rpx 12rpx 12rpx;
  gap: 10rpx;
}

.officer-tile-kicker {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 2rpx;
}

.officer-tile-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.officer-tile-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.officer-tile--president .officer-tile-name {
  font-size: 28rpx;
}

.officer-tile-line {
  font-size: 22rpx;
  color: #666;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 24rpx;
  align-self: center;
}

.member-count text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 特色活动区域 */
.featured-event-section {
  padding: 32rpx;
  background: #fff;
}

/* 海报式特色活动卡片（对齐首页 .hot-club-trigger + isotope-background-container） */
.featured-event-poster-trigger {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.featured-event-poster-card {
  position: relative;
  width: 100%;
  min-height: 420rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 单层海报：地图铺满 hero，isotope 只占顶部一条，文字叠在底部（渐变只垫在下半，不盖标题上方） */
.featured-poster-hero {
  position: relative;
  width: 100%;
  min-height: 460rpx;
  overflow: hidden;
}

.featured-hero-map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.featured-hero-map animated-map {
  display: block;
  width: 100%;
  height: 100%;
}

.featured-hero-isotope {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

/* 自下而上渐亮：只抬底部阅读对比度，避免在标题上方铺大白 */
.featured-hero-bottom-readability {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 260rpx;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(
    0deg,
    rgba(255, 255, 255, 0.94) 0%,
    rgba(255, 255, 255, 0.55) 38%,
    rgba(255, 255, 255, 0) 100%
  );
}

/* 没有活动时的占位 */
.featured-event-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background: #fff;
  border-radius: 16rpx;
  min-height: 200rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.placeholder-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999;
}

/* 活动内容：叠在海报底部 */
.event-content {
  position: relative;
  z-index: 3;
  min-height: 200rpx;
}

.event-content--hero {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.event-content--hero .t-button,
.event-content--hero .event-status {
  pointer-events: auto;
}

.event-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.event-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
}

/* 活动操作行 */
.event-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 特色海报：不要中间分割线；状态 | 打卡（整体左移 100rpx）| 右侧地址 */
.event-action-row--hero {
  justify-content: flex-start;
  flex-wrap: nowrap;
  align-items: center;
  gap: 12rpx;
  border-top: none;
  padding-top: 12rpx;
}

.hero-clockin-shift {
  margin-left: 100rpx;
  flex-shrink: 0;
}

.hero-action-address {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 4rpx;
}

.hero-action-address-text {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-status {
  font-size: 26rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.status-upcoming {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

.status-ongoing {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.status-ended {
  background: rgba(0, 0, 0, 0.05);
  color: #999;
}

/* 活动分页网格 */
.events-list-section {
  padding: 0 24rpx 32rpx;
  background: #fff;
}

.events-page-wrap {
  width: 100%;
}

.events-page-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 8rpx 0 16rpx;
}

.events-page-btn {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #ff6b9d;
  border: 1rpx solid rgba(255, 107, 157, 0.45);
  border-radius: 999rpx;
  background: #fff;
}

.events-page-btn.is-disabled {
  color: #ccc;
  border-color: #eee;
  pointer-events: none;
}

.events-page-label {
  font-size: 26rpx;
  color: #666;
  min-width: 120rpx;
  text-align: center;
}

.events-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  /* 每行 4 个：列间距 12rpx×3；行间距 16rpx */
  gap: 16rpx 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.events-grid.is-dim {
  opacity: 0.55;
  pointer-events: none;
}

.event-grid-slot {
  /* 每行 4 个，横向 gap 12rpx ×3 */
  width: calc((100% - 36rpx) / 4);
  box-sizing: border-box;
}

.event-grid-cell {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.event-grid-cover-wrap {
  position: relative;
  width: 100%;
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
  background: #f0f0f0;
}

.event-grid-cover {
  display: block;
  width: 100%;
  height: 180rpx;
  vertical-align: top;
}

.event-grid-cover-wrap.is-ended .event-grid-cover {
  filter: grayscale(1);
  opacity: 0.72;
}

.join-mark {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  padding: 4rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  font-weight: 700;
  line-height: 1;
  background: transparent;
  box-shadow: none;
  text-shadow: 0 0 12rpx rgba(255, 255, 255, 0.95), 0 0 4rpx rgba(255, 255, 255, 1);
}

.join-mark--ok {
  color: #389e0d;
  background: transparent;
}

.join-mark--no {
  color: #cf1322;
  background: transparent;
}

.event-grid-body {
  padding: 10rpx 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.event-grid-count {
  font-size: 22rpx;
  color: #666;
}

.event-grid-time {
  font-size: 22rpx;
  color: #999;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  word-break: break-all;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 底部安全距离（与 footer-space 叠加留白） */
.bottom-safe-area {
  height: 120rpx;
}


/* 嵌套弹窗样式 */
.nested-popup-shell {
  width: 100%;
  height: 100%;
  background: transparent;
}

@import "../../../styles/panel-component-host.wxss";

/* packageProfile/components/user-info-panel/index.wxss */
.user-info-panel {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.panel-scroll {
  flex: 1;
  height: 100%;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.user-info-container {
  width: 100%;
  padding: 10rpx 0 40rpx;
}

.avatar-section {
  background-color: #fff;
  padding: 40rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.avatar-wrap--editable:active {
  opacity: 0.85;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(25, 137, 250, 0.2);
  display: block;
}

.avatar-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  border-radius: 0 0 80rpx 80rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-overlay-text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1.2;
  text-align: center;
  padding: 0 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 0 40rpx;
}

.sync-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #fffbe6;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #8c6d1f;
  line-height: 1.5;
}

.info-section {
  background-color: #fff;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.info-value--placeholder {
  color: #bbb;
}

.info-value-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.info-value-wrap--action {
  flex-wrap: wrap;
  gap: 8rpx;
}

.readonly-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 6rpx;
}

.action-link {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1989fa;
  padding: 8rpx 0 8rpx 16rpx;
}

.view-only-hint {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 24rpx 30rpx 0;
}

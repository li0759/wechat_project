.lr-root {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.lr-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  pointer-events: none;
}

.lr-overlay--fade {
  opacity: 0;
}

.lr-ring {
  box-sizing: border-box;
  border-radius: 50%;
  border-style: solid;
}

.lr-badge {
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  z-index: 3;
  pointer-events: none;
}

.lr-badge--in {
  opacity: 1;
}

.lr-badge__text {
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

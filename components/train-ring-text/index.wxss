.train-ring-root {
  position: relative;
  pointer-events: none;
}

.train-track {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.train-inner-hole {
  position: absolute;
  border-radius: 50%;
}

.tunnel-mouth {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  z-index: 4;
}

.train-char {
  position: absolute;
  z-index: 3;
  font-weight: 600;
  line-height: 1;
  white-space: pre;
  padding: 2rpx 4rpx;
  border-radius: 6rpx;
  transform-origin: center center;
  transition: opacity 120ms linear;
}

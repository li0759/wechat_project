<!--packageProfile/components/all-club-users-panel/index.wxml-->
<view class="container">
  <scroll-view class="panel-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
    <view class="page-header">
      <view class="title">会员数据</view>
    </view>

    <view class="date-filter-card">
      <view class="date-filter-title">按加入时间筛选用户</view>
      <view class="date-filter-row">
        <view class="date-picker-item">
          <view class="date-label">开始日期</view>
          <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
            <view class="date-picker-value">{{startDate || '请选择开始日期'}}</view>
          </picker>
        </view>
        <view class="date-picker-item">
          <view class="date-label">结束日期</view>
          <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
            <view class="date-picker-value">{{endDate || '请选择结束日期'}}</view>
          </picker>
        </view>
      </view>
      <view class="date-filter-title activity-title">按开展时间筛选活动</view>
      <view class="date-filter-row">
        <view class="date-picker-item">
          <view class="date-label">活动开始日期</view>
          <picker mode="date" value="{{activityStartDate}}" bindchange="onActivityStartDateChange">
            <view class="date-picker-value">{{activityStartDate || '不限制'}}</view>
          </picker>
        </view>
        <view class="date-picker-item">
          <view class="date-label">活动结束日期</view>
          <picker mode="date" value="{{activityEndDate}}" bindchange="onActivityEndDateChange">
            <view class="date-picker-value">{{activityEndDate || '不限制'}}</view>
          </picker>
        </view>
      </view>

      <view class="export-options">
        <checkbox-group bindchange="onSplitByClubChange">
          <label class="checkbox-label">
            <checkbox value="split" checked="{{splitByClub}}" color="#df76b0" />
            <text>按协会区分</text>
          </label>
        </checkbox-group>
      </view>

      <t-button
        wx:if="{{startDate && endDate && activityStartDate && activityEndDate}}"
        theme="primary"
        size="small"
        loading="{{downloading}}"
        class="download-btn"
        bindtap="downloadExcel"
      >
        发送文件
      </t-button>
    </view>

    <view wx:if="{{startDate && endDate && activityStartDate && activityEndDate && loading}}" class="loading-container">
      <t-loading size="24px" theme="circular" />
      <view class="loading-text">正在加载数据...</view>
    </view>

    <view wx:elif="{{startDate && endDate && activityStartDate && activityEndDate}}" class="content">
      <!-- 总体统计卡片 -->
      <view class="stats-overview">
        <view class="stats-card">
          <view class="stats-number">{{totalClubs}}</view>
          <view class="stats-label">协会总数</view>
        </view>
        <view class="stats-card">
          <view class="stats-number">{{totalMembers}}</view>
          <view class="stats-label">会员总数</view>
        </view>
        <view class="stats-card">
          <view class="stats-number">{{Math.round(totalMembers/totalClubs * 100)/100 || 0}}</view>
          <view class="stats-label">平均人数</view>
        </view>
        <view class="stats-card">
          <view class="stats-number">{{totalDynamics}}</view>
          <view class="stats-label">动态数量</view>
        </view>
      </view>
      
      <!-- 图表展示区域 -->
      <view class="charts-section" wx:if="{{!hideCharts}}">
        <!-- 协会会员数量柱状图 -->
        <view class="chart-container">
          <bar-chart 
            data="{{clubMemberChart}}" 
            title="各协会会员数量分布"
            height="{{300}}"
            bar-color="#df76b0"
            show-value="{{true}}"
          />
        </view>
        
        <!-- 会员性别比例饼图 -->
        <view class="chart-container" wx:if="{{genderChart.length > 0}}">
          <pie-chart 
            data="{{genderChart}}" 
            title="会员性别分布"
            height="{{280}}"
            colors="{{['#df76b0', '#9c88ff', '#f4b844']}}"
          />
        </view>
        
        <!-- 单位分布图 -->
        <view class="chart-container" wx:if="{{unitChart.length > 0}}">
          <pie-chart 
            data="{{unitChart}}" 
            title="会员单位分布（前8名）"
            height="{{280}}"
            colors="{{['#df76b0', '#9c88ff', '#5fb3d4', '#f4b844', '#67c23a', '#ff5722', '#e91e63', '#9e9e9e']}}"
          />
        </view>
      </view>
    </view>

    <view wx:else class="empty-tip">
      请先选择4个时间后查看图表并发送文件
    </view>

    <view class="bottom-safe-area"></view>
  </scroll-view>
</view> 
<panel-loading-transition
  duration="280"
  command="{{pltCommand}}"
  auto-need-load="{{true}}"
  bind:needload="loadData"
  bind:loaded="onPanelLoadTransitionDone"
>
  <view slot="skeleton">
    <club-events-skeleton />
  </view>
  <view slot="content">
<view class="cmp-panel-root cmp-panel-root--member-list">

  <t-empty
    wx:if="{{events.length === 0}}"
    icon="calendar"
    description="暂无活动"
  />

  <view wx:if="{{events.length > 0}}" class="members-main cm-indexes-shell">
    <view class="cm-member-toolbar">
      <view wx:if="{{bulkMode}}" class="cm-bulk-send-bar">
        <view class="cm-bulk-icon-btn" hover-class="cm-bulk-icon-btn--hover" bindtap="onExitBulkMode">
          <t-icon name="rollback" size="24" color="#df76b0" />
        </view>
        <view
          class="cm-bulk-icon-btn {{bulkTotalVisible > 0 ? '' : 'cm-bulk-icon-btn--disabled'}}"
          hover-class="cm-bulk-icon-btn--hover"
          bindtap="onSelectAllBulk"
        >
          <t-icon wx:if="{{bulkAllSelected}}" name="data-error" size="24" color="#df76b0" />
          <t-icon wx:else name="data-checked" size="24" color="#df76b0" />
        </view>
        <text class="cm-bulk-send-text">
          {{bulkSelectedCount > 0 ? ('已选' + bulkSelectedCount + '个活动，点击下载参与明细') : '请选择至少一个活动'}}
        </text>
        <view
          class="cm-bulk-icon-btn cm-bulk-icon-btn--send {{bulkSending ? 'cm-bulk-icon-btn--loading' : ''}} {{bulkSelectedCount > 0 ? '' : 'cm-bulk-icon-btn--disabled'}}"
          hover-class="cm-bulk-icon-btn--hover"
          bindtap="onSendBulkEvents"
        >
          <t-icon name="send" size="24" color="#df76b0" />
        </view>
      </view>
      <t-search
        wx:else
        value="{{searchKeyword}}"
        shape="round"
        placeholder="搜索活动名称、地点"
        bind:change="onEventListSearchChange"
        bind:clear="onEventListSearchClear"
      />
    </view>

    <view wx:if="{{filteredEvents.length === 0}}" class="cm-filter-empty">
      <t-empty icon="search" description="未找到相关活动" />
    </view>

    <view wx:else class="cm-member-list-root">
      <view class="cm-tab-body-fill">
        <club-event-indexes
          id="event-indexes-month"
          expandable-id-suffix="month"
          club-id="{{clubId}}"
          groups="{{monthEventGroups}}"
          index-sidebar="{{monthIndexSidebar}}"
          default-cover="{{default_cover}}"
          bind:bulkselectchange="onBulkSelectChange"
          bind:eventupdated="onEventUpdated"
        />
      </view>
    </view>
  </view>

  <!-- 添加活动悬浮按钮（加载中由骨架屏展示，避免双 FAB） -->
  <view class="fab-container" wx:if="{{events.length > 0}}">
    <expandable-container_fullscreen
      id="nestedEventCreatePopup"
      expanded-width="750"
      expanded-height="1800"
      bg-color="rgba(223, 118, 176, 0.8)"
      fullscreen-sheet-bg-color="#f7f8fa"
      fullscreen-top-padding="{{0}}"
      bind:collapse="onNestedEventCreateCollapse"
      bind:collapsed="onNestedEventCreateCollapsed"
      bind:contentReady="onNestedEventCreateContentReady"
    >
      <view slot="trigger" class="fab-add">
        <t-icon name="add" size="28" />
      </view>
      <view slot="content" class="nested-popup-shell">
        <view
          wx:if="{{nestedEventCreate.loading}}"
          style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; background: #f7f8fa;"
        >
          <event-create-skeleton />
        </view>
        <block wx:if="{{nestedEventCreate.renderPanel}}">
          <event-create-panel
            id="nestedEventCreatePanel"
            club-id="{{clubId * 1}}"
            bind:loaded="onNestedEventCreateLoaded"
            bind:create-success="onNestedEventCreateSuccess"
            bind:create-error="onNestedEventCreateError"
            bind:close="closeNestedEventCreate"
          />
        </block>
      </view>
    </expandable-container_fullscreen>
  </view>

  <t-toast id="t-toast" />
</view>
  </view>
</panel-loading-transition>

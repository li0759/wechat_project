/**
 * root-portal 将遮罩/弹窗挂到页面根时，部分环境下不继承组件 wxss，
 * 此处与 expandable-container/index.wxss 对齐，仅作用于 .ec-expand-portal-host 子树。
 */
.ec-expand-portal-host .expandable-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  animation: ecExpandFadeIn 0.2s ease-out forwards;
}

.ec-expand-portal-host .expandable-overlay-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.ec-expand-portal-host .expandable-overlay-nested {
  background-color: rgba(0, 0, 0, 0.45) !important;
  animation: none !important;
}

.ec-expand-portal-host .popup-container-fixed {
  position: fixed;
}

.ec-expand-portal-host .popup-container {
  overflow: hidden;
}

.ec-expand-portal-host .popup-clip-inner {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: inherit;
  overflow: hidden;
}

.ec-expand-portal-host .popup-content {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 1;
  background-color: #f7f8fa;
  border-radius: inherit;
}

.ec-expand-portal-host .ripple-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--mask-color, #6750a4);
  z-index: 9999;
  border-radius: inherit;
  pointer-events: none;
  will-change: background;
  opacity: 0;
  transition: none;
}

.ec-expand-portal-host .ripple-mask.ripple-reveal,
.ec-expand-portal-host .ripple-mask.ripple-collapse {
  opacity: 1;
}

.ec-expand-portal-host .ripple-mask.ripple-reveal {
  animation: ecExpandRippleReveal var(--ripple-dur, 300ms) cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.ec-expand-portal-host .ripple-mask.ripple-collapse {
  animation: ecExpandRippleCollapse var(--ripple-dur, 300ms) cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.ec-expand-portal-host .ripple-mask.ripple-complete {
  opacity: 0;
  pointer-events: none;
}

@keyframes ecExpandFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ecExpandRippleReveal {
  0% {
    background: radial-gradient(circle at center, transparent 0%, var(--mask-color) 0%);
  }
  5% {
    background: radial-gradient(circle at center, transparent 5%, var(--mask-color) 5%);
  }
  10% {
    background: radial-gradient(circle at center, transparent 10%, var(--mask-color) 10%);
  }
  15% {
    background: radial-gradient(circle at center, transparent 15%, var(--mask-color) 15%);
  }
  20% {
    background: radial-gradient(circle at center, transparent 20%, var(--mask-color) 20%);
  }
  25% {
    background: radial-gradient(circle at center, transparent 25%, var(--mask-color) 25%);
  }
  30% {
    background: radial-gradient(circle at center, transparent 30%, var(--mask-color) 30%);
  }
  35% {
    background: radial-gradient(circle at center, transparent 35%, var(--mask-color) 35%);
  }
  40% {
    background: radial-gradient(circle at center, transparent 40%, var(--mask-color) 40%);
  }
  45% {
    background: radial-gradient(circle at center, transparent 45%, var(--mask-color) 45%);
  }
  50% {
    background: radial-gradient(circle at center, transparent 50%, var(--mask-color) 50%);
  }
  55% {
    background: radial-gradient(circle at center, transparent 55%, var(--mask-color) 55%);
  }
  60% {
    background: radial-gradient(circle at center, transparent 60%, var(--mask-color) 60%);
  }
  65% {
    background: radial-gradient(circle at center, transparent 65%, var(--mask-color) 65%);
  }
  70% {
    background: radial-gradient(circle at center, transparent 70%, var(--mask-color) 70%);
  }
  75% {
    background: radial-gradient(circle at center, transparent 75%, var(--mask-color) 75%);
  }
  80% {
    background: radial-gradient(circle at center, transparent 80%, var(--mask-color) 80%);
  }
  85% {
    background: radial-gradient(circle at center, transparent 85%, var(--mask-color) 85%);
  }
  90% {
    background: radial-gradient(circle at center, transparent 90%, var(--mask-color) 90%);
  }
  95% {
    background: radial-gradient(circle at center, transparent 95%, var(--mask-color) 95%);
  }
  100% {
    background: radial-gradient(circle at center, transparent 100%, var(--mask-color) 100%);
  }
}

@keyframes ecExpandRippleCollapse {
  0% {
    background: radial-gradient(circle at center, transparent 100%, var(--mask-color) 100%);
  }
  5% {
    background: radial-gradient(circle at center, transparent 95%, var(--mask-color) 95%);
  }
  10% {
    background: radial-gradient(circle at center, transparent 90%, var(--mask-color) 90%);
  }
  15% {
    background: radial-gradient(circle at center, transparent 85%, var(--mask-color) 85%);
  }
  20% {
    background: radial-gradient(circle at center, transparent 80%, var(--mask-color) 80%);
  }
  25% {
    background: radial-gradient(circle at center, transparent 75%, var(--mask-color) 75%);
  }
  30% {
    background: radial-gradient(circle at center, transparent 70%, var(--mask-color) 70%);
  }
  35% {
    background: radial-gradient(circle at center, transparent 65%, var(--mask-color) 65%);
  }
  40% {
    background: radial-gradient(circle at center, transparent 60%, var(--mask-color) 60%);
  }
  45% {
    background: radial-gradient(circle at center, transparent 55%, var(--mask-color) 55%);
  }
  50% {
    background: radial-gradient(circle at center, transparent 50%, var(--mask-color) 50%);
  }
  55% {
    background: radial-gradient(circle at center, transparent 45%, var(--mask-color) 45%);
  }
  60% {
    background: radial-gradient(circle at center, transparent 40%, var(--mask-color) 40%);
  }
  65% {
    background: radial-gradient(circle at center, transparent 35%, var(--mask-color) 35%);
  }
  70% {
    background: radial-gradient(circle at center, transparent 30%, var(--mask-color) 30%);
  }
  75% {
    background: radial-gradient(circle at center, transparent 25%, var(--mask-color) 25%);
  }
  80% {
    background: radial-gradient(circle at center, transparent 20%, var(--mask-color) 20%);
  }
  85% {
    background: radial-gradient(circle at center, transparent 15%, var(--mask-color) 15%);
  }
  90% {
    background: radial-gradient(circle at center, transparent 10%, var(--mask-color) 10%);
  }
  95% {
    background: radial-gradient(circle at center, transparent 5%, var(--mask-color) 5%);
  }
  100% {
    background: radial-gradient(circle at center, transparent 0%, var(--mask-color) 0%);
  }
}

/* root-portal 内成员详情 slot（原 club-members-panel wxss，脱离面板后需全局命中） */
.ec-expand-portal-host .am-user-detail {
  position: relative;
  z-index: 10;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.ec-expand-portal-host .am-detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
}

.ec-expand-portal-host .am-detail-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f2f3f5;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.ec-expand-portal-host .am-detail-main {
  flex: 1;
  min-width: 0;
}

.ec-expand-portal-host .am-detail-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ec-expand-portal-host .am-detail-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ec-expand-portal-host .am-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  line-height: 1.2;
}

.ec-expand-portal-host .am-tag-dept {
  color: #667eea;
  background: rgba(102, 126, 234, 0.12);
}

.ec-expand-portal-host .am-tag-pos {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.12);
}

.ec-expand-portal-host .am-tag-role {
  color: #666;
  background: rgba(0, 0, 0, 0.06);
}

.ec-expand-portal-host .am-tag-role.president {
  color: #ff6b9d;
  background: rgba(255, 107, 157, 0.14);
}

.ec-expand-portal-host .am-tag-role.vice_president {
  color: #ffc107;
  background: rgba(255, 193, 7, 0.16);
}

.ec-expand-portal-host .am-tag-role.director {
  color: #2196f3;
  background: rgba(33, 150, 243, 0.14);
}

.ec-expand-portal-host .am-tag-role.member {
  color: #9e9e9e;
  background: rgba(158, 158, 158, 0.14);
}

.ec-expand-portal-host .am-detail-kv {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ec-expand-portal-host .am-kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.ec-expand-portal-host .am-kv:last-child {
  border-bottom: none;
}

.ec-expand-portal-host .am-k {
  font-size: 26rpx;
  color: #999;
  font-weight: 700;
}

.ec-expand-portal-host .am-v {
  font-size: 26rpx;
  color: #333;
  font-weight: 800;
  max-width: 420rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ec-expand-portal-host .am-detail-actions {
  padding-top: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ec-expand-portal-host .am-admin-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.ec-expand-portal-host .am-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.ec-expand-portal-host .am-btn-primary {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.ec-expand-portal-host .am-btn-ghost {
  background: rgba(102, 126, 234, 0.08);
  color: #667eea;
}

.ec-expand-portal-host .am-btn-danger {
  background: rgba(255, 107, 157, 0.12);
  color: #ff6b9d;
}

.ec-expand-portal-host .am-btn-hover {
  background: rgba(102, 126, 234, 0.18);
}

.ec-expand-portal-host .am-btn-danger-hover {
  background: rgba(255, 107, 157, 0.22);
}

.ec-expand-portal-host .am-added {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #52c41a;
}


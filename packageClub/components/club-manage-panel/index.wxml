              maxlength="200"
              indicator
              bind:change="onPendingPopupApproveOpinionChange"
            />
          </view>
          <view
            class="am-btn am-btn-approve am-pending-action-btn"
            catchtap="approveApplicationFromSharedPopup"
            data-applicationid="{{currentPendingApplication.applicationID}}"
          >
            <t-icon name="check" size="16" color="#52c41a" />
            <text>批准入会</text>
          </view>

          <view class="approval-form-inline am-pending-form-block am-pending-form-block-reject">
            <view class="am-pending-field-label">拒绝理由（必填）</view>
            <t-textarea
              value="{{pendingPopupRejectReason}}"
              placeholder="请输入拒绝理由"
              bordered="{{false}}"
              autosize="{{ { minHeight: 72, maxHeight: 120 } }}"
              maxlength="200"
              indicator
              bind:change="onPendingPopupRejectReasonChange"
            />
          </view>
          <view
            class="am-btn am-btn-reject am-pending-action-btn"
            catchtap="rejectApplicationFromSharedPopup"
            data-applicationid="{{currentPendingApplication.applicationID}}"
          >
            <t-icon name="close" size="16" color="#ff4d4f" />
            <text>拒绝申请</text>
          </view>
        </view>
      </view>
    </view>
  </expandable-container>
</view>



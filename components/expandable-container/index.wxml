<!--components/expandable-container/index.wxml-->
<!-- 新版：遮罩层 + 弹窗(clip-path控制) + 涟漪遮罩层 -->
<!-- overlayUseRootPortal 时用 root-portal，避免 swiper 等 transform 祖先导致 fixed 错位 -->

<!-- 触发器 -->
<view
  class="expandable-wrapper {{triggerStretch ? 'expandable-wrapper--stretch' : ''}}"
  style="{{triggerHostStyle}}"
  catchtap="handleTriggerTap"
>
  <view class="trigger-content {{triggerStretch ? 'trigger-content--stretch' : ''}}">
    <slot name="trigger"></slot>
  </view>
</view>

<block wx:if="{{!overlayUseRootPortal}}">
  <!-- 1. 全屏灰暗遮罩层 -->
  <view
    wx:if="{{isExpanded || isExpanding}}"
    class="expandable-overlay expandable-overlay-fixed"
    style="z-index: {{effectiveZIndex}};"
    catchtap="handleOverlayTap"
  ></view>

  <!-- 2. 弹窗 -->
  <view
    wx:if="{{clipVisible}}"
    class="popup-container popup-container-fixed"
    style="{{popupFrameStyle}}"
    catchtap="handleContentTap"
  >
    <view class="popup-clip-inner" style="{{popupClipStyle}}">
      <view
        class="ripple-mask {{rippleMaskClass}}"
        style="--mask-color: {{maskColor}}; --ripple-dur: {{rippleDur}}ms;"
      ></view>
      <view class="popup-content">
        <slot name="content"></slot>
      </view>
    </view>
  </view>
</block>

<root-portal wx:elif="{{overlayUseRootPortal}}">
  <view class="ec-expand-portal-host">
    <view
      wx:if="{{isExpanded || isExpanding}}"
      class="expandable-overlay expandable-overlay-fixed"
      style="z-index: {{effectiveZIndex}};"
      catchtap="handleOverlayTap"
    ></view>
    <view
      wx:if="{{clipVisible}}"
      class="popup-container popup-container-fixed"
      style="{{popupFrameStyle}}"
      catchtap="handleContentTap"
    >
      <view class="popup-clip-inner" style="{{popupClipStyle}}">
        <view
          class="ripple-mask {{rippleMaskClass}}"
          style="--mask-color: {{maskColor}}; --ripple-dur: {{rippleDur}}ms;"
        ></view>
        <view class="popup-content">
          <slot name="content"></slot>
        </view>
      </view>
    </view>
  </view>
</root-portal>

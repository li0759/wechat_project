:host {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.plt-root {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.plt-content {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  z-index: 1;
  overflow: hidden;
}

.plt-content > view {
  flex: 1 1 0;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.plt-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  opacity: 1;
  visibility: visible;
  transition-property: opacity;
  transition-timing-function: ease;
  pointer-events: none;
}

.plt-skeleton--fading {
  opacity: 0;
}

.plt-skeleton--gone {
  opacity: 0;
  visibility: hidden;
  z-index: -1;
}

<!-- 协会管理骨架：对齐 club-manage-panel 新布局（海报区仅外框） -->
<view class="sk-manage">
  <view class="sk-rows">
    <!-- 基本信息 + 协会章程 -->
    <view class="sk-split-row">
      <view class="sk-card sk-card-basic">
        <view class="sk-card-head">
          <t-skeleton animation="gradient" rowCol="{{[{ width: '112rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
          <t-skeleton animation="gradient" rowCol="{{[{ width: '88rpx', height: '20rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}" />
        </view>
        <view class="sk-card-body">
          <t-skeleton animation="gradient" rowCol="{{[{ width: '200rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
          <t-skeleton animation="gradient" rowCol="{{[{ width: '160rpx', height: '24rpx', borderRadius: '6rpx', marginTop: '8rpx' }]}}" />
        </view>
      </view>
      <view class="sk-card sk-card-charter">
        <view class="sk-card-head">
          <t-skeleton animation="gradient" rowCol="{{[{ width: '112rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
          <t-skeleton animation="gradient" rowCol="{{[{ width: '88rpx', height: '20rpx', borderRadius: '6rpx', marginTop: '4rpx' }]}}" />
        </view>
        <view class="sk-card-body sk-card-body--end">
          <t-skeleton animation="gradient" rowCol="{{[{ width: '96rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
        </view>
      </view>
    </view>

    <!-- 协会海报：全宽，预览区只保留外边框 -->
    <view class="sk-panel sk-panel-post">
      <view class="sk-panel-header">
        <t-skeleton animation="gradient" rowCol="{{[{ width: '140rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
        <t-skeleton animation="gradient" rowCol="{{[{ width: '180rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
      </view>
      <view class="sk-post-preview-box"></view>
    </view>

    <!-- 协会封面 + 活动管理 -->
    <view class="sk-split-row">
      <view class="sk-panel sk-panel-half">
        <view class="sk-panel-header">
          <t-skeleton animation="gradient" rowCol="{{[{ width: '120rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
          <t-skeleton animation="gradient" rowCol="{{[{ width: '96rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
        </view>
        <view class="sk-cover-preview"></view>
      </view>
      <view class="sk-panel sk-panel-half">
        <view class="sk-panel-header">
          <t-skeleton animation="gradient" rowCol="{{[{ width: '120rpx', height: '28rpx', borderRadius: '6rpx' }]}}" />
          <t-skeleton animation="gradient" rowCol="{{[{ width: '48rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
        </view>
        <view class="sk-mini-rows">
          <view class="sk-mini-row">
            <t-skeleton animation="gradient" rowCol="{{[{ width: '96rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
            <t-skeleton animation="gradient" rowCol="{{[{ width: '140rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
          </view>
          <view class="sk-mini-row">
            <t-skeleton animation="gradient" rowCol="{{[{ width: '56rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
            <t-skeleton animation="gradient" rowCol="{{[{ width: '120rpx', height: '24rpx', borderRadius: '6rpx' }]}}" />
          </view>
        </view>
      </view>
    </view>

    <view class="sk-footer-space"></view>
  </view>

  <view class="sk-bottom-actions">
    <t-skeleton animation="gradient" rowCol="{{[{ width: '320rpx', height: '80rpx', borderRadius: '40rpx' }]}}" />
    <t-skeleton animation="gradient" rowCol="{{[{ width: '320rpx', height: '80rpx', borderRadius: '40rpx' }]}}" />
  </view>
</view>

.clockin-signature-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000003;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.clockin-signature-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.clockin-signature-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
}

.signature-popup {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  border-radius: 24rpx 24rpx 0 0;
}

.signature-popup__title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: rgba(0, 0, 0, 0.88);
}

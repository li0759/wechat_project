@import "../../../styles/panel-bottom-actions.wxss";

/* event-manage-panel 组件样式 - 视觉优化版 */
.event-manage-panel {
  /* 优化后的设计 token */
  --md-sys-color-primary: #DF76B0;
  --md-sys-color-primary-dark: #C85A9E;
  --md-sys-color-primary-light: rgba(223, 118, 176, 0.1);
  --md-sys-color-on-primary: #FFFFFF;
  --md-sys-color-primary-container: rgba(223, 118, 176, 0.1);
  --md-sys-color-secondary: #6F767E;
  --md-sys-color-surface: #FFFFFF;
  --md-sys-color-on-surface: #1A1D1F;
  --md-sys-color-surface-variant: #F2F4F7;
  --md-sys-color-on-surface-variant: #6F767E;
  --md-sys-color-background: #F8F9FB;
  /* 优化阴影：从厚重改为轻柔 */
  --md-sys-elevation-1: 0 2rpx 4rpx rgba(0, 0, 0, 0.06), 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
  --md-sys-elevation-2: 0 4rpx 8rpx rgba(0, 0, 0, 0.08), 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  /* 统一圆角 */
  --md-sys-shape-corner-large: 20rpx;
  --md-sys-shape-corner-medium: 16rpx;
  --md-sys-shape-corner-small: 12rpx;
  
  /* 容器布局 - 参考 event-detail-panel */
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--md-sys-color-background);
  color: var(--md-sys-color-on-surface);

}

/* 灰色蒙层样式 */
.disabled-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: all;
}

.disabled-overlay-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 20rpx;
  margin: 40rpx;
}

.disabled-overlay-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.disabled-overlay-desc {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* 主内容区域：在父级 flex 列内占满剩余高度，勿用 100vh（全屏弹层内会超高裁切底栏） */
.main-content {
  flex: 1;
  min-height: 0;
}

/* 底部留白：在 styles/panel-bottom-actions 的 280rpx 上再加 200rpx，便于滚到列表最底 */
.event-manage-panel .footer-space {
  height: 480rpx;
}

.rows { padding: 16rpx 16rpx 24rpx; box-sizing: border-box; }

/* 标题 / 简介 / 预计开始·结束：固定 2×2，避免 expandable 随内容撑破一行 */
.meta-fields-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.meta-field-cell {
  box-sizing: border-box;
  width: calc((100% - 12rpx) / 2);
  flex: 0 0 calc((100% - 12rpx) / 2);
  max-width: calc((100% - 12rpx) / 2);
  min-width: 0;
}

.meta-field-cell .row,
.meta-field-cell .row-basic {
  margin-bottom: 0;
}

.meta-field-cell .row {
  min-width: 0;
}

.meta-field-cell .row-value {
  max-width: 100%;
  min-width: 0;
}

.row {
  background: var(--md-sys-color-surface);
  border-radius: var(--md-sys-shape-corner-medium);
  box-shadow: var(--md-sys-elevation-1);
  border: 1rpx solid #E5E7EB;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  transition: all 0.2s;
}

.row:active {
  background: var(--md-sys-color-surface-variant);
  border-color: var(--md-sys-color-primary);
  transform: scale(0.99);
}

.row-100 { height: 100rpx; }
.row-80 { height: 80rpx; }
.row-300 { height: 300rpx; }

.row-basic { padding: 18rpx 20rpx; align-items: flex-start; }
.row-basic-left { flex: 0 0 auto; min-width: 140rpx; padding-top: 6rpx; }
.row-basic-right { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.row-basic-title { font-size: 30rpx; font-weight: 600; color: var(--md-sys-color-on-surface); }
.row-basic-desc { font-size: 24rpx; color: var(--md-sys-color-on-surface-variant); font-weight: 400; -webkit-line-clamp: 2; }
.row-basic-arrow { flex: 0 0 auto; padding-top: 6rpx; transition: transform 0.2s; }

/* 可编辑行样式（增强可供性）*/
.row-editable {
  transition: all 0.3s;
  cursor: pointer;
}

.row-editable:active {
  background: var(--md-sys-color-surface-variant);
  border-color: var(--md-sys-color-primary);
  transform: scale(0.99);
}

.row-editable:active .row-basic-arrow {
  transform: scale(1.1);
}

/* 编辑提示文案 */
.edit-hint {
  font-size: 20rpx;
  color: var(--md-sys-color-primary);
  margin-top: 4rpx;
  font-weight: 500;
}

.plain-line { padding: 10rpx 6rpx; margin: 0 6rpx 10rpx; display: flex; align-items: center; gap: 10rpx; color: #333; }
.plain-k { font-size: 26rpx; font-weight: 600; color: var(--md-sys-color-on-surface); }
.plain-v { font-size: 26rpx; font-weight: 400; color: var(--md-sys-color-on-surface-variant); }

/* ===== 状态卡片样式（布局哲学优化）===== */
.status-card {
  background: var(--md-sys-color-surface);
  border: 1rpx solid #E5E7EB;
  border-radius: var(--md-sys-shape-corner-medium);
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--md-sys-elevation-1);
}

.status-card--interactive {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.status-card--interactive:active {
  opacity: 0.92;
  transform: scale(0.998);
}

.status-card-tap-hint {
  font-size: 20rpx;
  color: #9ca3af;
  text-align: center;
  padding-top: 10rpx;
  margin-top: 4rpx;
  border-top: 1rpx solid #f0f0f0;
}

.status-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.status-header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  gap: 12rpx;
}

.status-inline-start {
  font-size: 24rpx;
  color: var(--md-sys-color-on-surface-variant);
  font-weight: 500;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-card-split {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-height: 200rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.status-card-col {
  flex: 1;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
}

.status-card-col-left {
  padding-right: 12rpx;
  border-right: 1rpx solid #E5E7EB;
}

.status-card-col-right {
  padding-left: 12rpx;
}

.timeline-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 10rpx;
  line-height: 1.35;
}

.timeline-time {
  flex: 0 0 128rpx;
  font-size: 19rpx;
  color: var(--md-sys-color-on-surface-variant);
}

.timeline-summary {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: var(--md-sys-color-on-surface);
  word-break: break-all;
}

.timeline-empty {
  font-size: 21rpx;
  color: #9ca3af;
  padding-top: 8rpx;
}

.status-avatar-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: flex-start;
  gap: 5rpx;
}

/* 顶部预览：固定 400rpx 槽宽；6 列 × 42rpx + 5rpx 间距，第 7 个起自动换行；rtl 与原先从右往左一致 */
.status-avatar-grid--top-rtl {
  display: grid;
  box-sizing: border-box;
  width: 400rpx;
  max-width: 100%;
  grid-template-columns: repeat(6, 42rpx);
  gap: 5rpx;
  direction: rtl;
  justify-content: start;
  position: relative;
  z-index: 2;
}

/* —— 顶部时间线预览：无边框、加高，底部白渐变与下方留白衔接 —— */
.top-preview-box {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 560rpx;
  margin-bottom: 12rpx;
  background: var(--md-sys-color-surface);
  border: none;
  border-radius: var(--md-sys-shape-corner-medium);
  box-shadow: none;
  box-sizing: border-box;
  overflow: hidden;
  padding: 8rpx 16rpx 12rpx;
}

/* 框高 70%～100%：白色遮罩，自上而下由全透明过渡到不透 */
.top-preview-stack-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 90%;
  bottom: 0;
  z-index: 6;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.88) 60%,
    #ffffff 100%
  );
}

.top-preview-box--interactive {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.top-preview-box--interactive:active {
  opacity: 0.96;
  transform: scale(0.998);
}

.top-preview-header.status-card-header {
  flex-shrink: 0;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
}

.top-preview-body {
  flex: 1;
  min-height: 0;
  position: relative;
}

.top-preview-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 0 0 8rpx 0;
}

.top-preview-inner .tl-modal-row {
  padding-bottom: 16rpx;
}

.top-preview-inner .tl-modal-left {
  width: 96rpx;
  padding-right: 6rpx;
}

.top-preview-inner .tl-axis-date {
  font-size: 20rpx;
}

.top-preview-inner .tl-axis-time {
  font-size: 18rpx;
}

.top-preview-inner .tl-modal-rail {
  width: 28rpx;
}

.top-preview-inner .tl-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 4rpx;
}

.top-preview-inner .tl-vline {
  min-height: 28rpx;
}

.top-preview-inner .tl-modal-main {
  padding: 0 4rpx 8rpx 0;
}

.top-preview-inner .tl-op-avatar {
  width: 48rpx;
  height: 48rpx;
}

.top-preview-inner .tl-op-name {
  font-size: 24rpx;
}

.top-preview-inner .tl-op-sub {
  font-size: 20rpx;
}

.top-preview-inner .tl-milestone-title {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.top-preview-inner .tl-moment-text {
  font-size: 24rpx;
}

.top-preview-inner .tl-modal-main--milestone-start,
.top-preview-inner .tl-modal-main--milestone-end {
  padding: 12rpx 14rpx 14rpx 12rpx;
  margin-bottom: 4rpx;
}

.top-preview-empty {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 24rpx 0 40rpx;
}

.top-preview-scrollpad {
  height: 32rpx;
}

.top-preview-avatars {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 8rpx 8rpx 8rpx 0;
  max-width: 48%;
  box-sizing: border-box;
  pointer-events: none;
  /* 头像区底板：仅容器背景渐变（与时间线衔接） */
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.38) 28rpx,
    rgba(255, 255, 255, 0.78) 72rpx,
    rgba(255, 255, 255, 0.94) 100%
  );
}

.top-preview-inner {
  position: relative;
  z-index: 1;
}

.status-avatar-cell {
  box-sizing: border-box;
  flex: 0 0 42rpx;
  width: 42rpx;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.status-avatar-inner {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.status-avatar-img {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: block;
  background: var(--md-sys-color-surface-variant);
}

.status-avatar-check {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 20rpx;
  height: 20rpx;
  font-size: 14rpx;
  line-height: 20rpx;
  text-align: center;
  color: #fff;
  background: var(--md-sys-color-primary, #DF76B0);
  border-radius: 50%;
  font-weight: 700;
}

/* —— 全屏活动时间线弹窗 —— */
.tl-modal-root {
  position: relative;
  padding: 0 !important;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

.tl-modal-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid #eceef2;
}

/* 悬浮分页点：不占文档流，叠在 swiper 内容之上 */
.tl-modal-page-dots {
  position: absolute;
  left: 50%;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 10rpx 32rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.12);
}

.tl-modal-page-dot-hit {
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tl-modal-page-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d1d5db;
  transition: transform 0.2s ease, background 0.2s ease;
}

.tl-modal-page-dot--active {
  background: var(--md-sys-color-primary, #df76b0);
  transform: scale(1.35);
}

.tl-modal-h-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--md-sys-color-on-surface);
}

.tl-modal-h-count {
  font-size: 24rpx;
  color: var(--md-sys-color-on-surface-variant);
}

.tl-modal-h-member-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 2rpx;
}

.tl-modal-h-ratio {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--md-sys-color-on-surface);
  line-height: 1.2;
}

.tl-modal-h-ratio-label {
  font-size: 20rpx;
  color: var(--md-sys-color-on-surface-variant);
  line-height: 1.2;
}

/* 全屏弹窗内双页 swiper：无顶部 Tab 文案，左右滑动切换 */
.tl-modal-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.tl-modal-swiper-item {
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.tl-modal-tab-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.tl-modal-scroll--members {
  padding: 8rpx 16rpx 0;
}

.tl-members-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx 6rpx;
  padding-bottom: 24rpx;
}

.tl-member-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.tl-member-avatar-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.tl-member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: block;
  background: var(--md-sys-color-surface-variant);
}

.tl-member-check {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 24rpx;
  height: 24rpx;
  font-size: 16rpx;
  line-height: 24rpx;
  text-align: center;
  color: #fff;
  background: var(--md-sys-color-primary, #df76b0);
  border-radius: 50%;
  font-weight: 700;
}

.tl-member-name {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--md-sys-color-on-surface);
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.tl-member-time {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #000000;
  text-align: center;
  width: 100%;
  line-height: 1.25;
}

.tl-modal-empty--members {
  padding-top: 80rpx;
}

.tl-modal-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 16rpx 8rpx 0 20rpx;
  box-sizing: border-box;
}

.tl-modal-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.tl-modal-left {
  width: 112rpx;
  flex-shrink: 0;
  padding-right: 8rpx;
  box-sizing: border-box;
  text-align: right;
}

.tl-axis-date {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--md-sys-color-on-surface-variant);
  line-height: 1.25;
}

.tl-axis-time {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.tl-modal-rail {
  width: 36rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--md-sys-color-primary);
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 1rpx rgba(223, 118, 176, 0.35);
  flex-shrink: 0;
  margin-top: 6rpx;
}

.tl-vline {
  width: 2rpx;
  flex: 1;
  min-height: 36rpx;
  margin-top: 4rpx;
  background: linear-gradient(180deg, rgba(223, 118, 176, 0.45) 0%, rgba(223, 118, 176, 0.08) 100%);
  border-radius: 1rpx;
}

.tl-modal-main {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx 28rpx 4rpx;
  box-sizing: border-box;
}

.tl-modal-main--milestone-start {
  background: linear-gradient(90deg, rgba(223, 118, 176, 0.22) 0%, rgba(223, 118, 176, 0.08) 50%, rgba(255, 255, 255, 0) 100%);
  border-left: 6rpx solid var(--md-sys-color-primary);
  border-right: 2rpx dashed rgba(223, 118, 176, 0.45);
  border-radius: 14rpx;
  padding: 18rpx 20rpx 22rpx 16rpx;
  margin-bottom: 8rpx;
}

.tl-modal-main--milestone-end {
  background: linear-gradient(90deg, rgba(107, 114, 128, 0.2) 0%, rgba(107, 114, 128, 0.07) 52%, rgba(255, 255, 255, 0) 100%);
  border-left: 6rpx solid #6b7280;
  border-right: 2rpx dashed rgba(107, 114, 128, 0.42);
  border-radius: 14rpx;
  padding: 18rpx 20rpx 22rpx 16rpx;
  margin-bottom: 8rpx;
}

.tl-milestone-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--md-sys-color-on-surface);
  margin-bottom: 12rpx;
}

.tl-op-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}

.tl-op-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--md-sys-color-surface-variant);
}

.tl-op-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tl-op-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--md-sys-color-on-surface);
}

.tl-op-sub {
  font-size: 24rpx;
  color: var(--md-sys-color-on-surface-variant);
  line-height: 1.35;
  word-break: break-all;
}

.tl-plain-summary {
  font-size: 26rpx;
  color: var(--md-sys-color-on-surface);
  line-height: 1.4;
  word-break: break-all;
}

.tl-moment-body {
  margin-top: 12rpx;
}

.tl-moment-text {
  font-size: 28rpx;
  color: var(--md-sys-color-on-surface);
  line-height: 1.45;
  word-break: break-all;
}

.tl-moment-images {
  margin-top: 12rpx;
}

.tl-images-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tl-modal-empty {
  padding: 48rpx 0;
}

.tl-modal-loading,
.tl-modal-end {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 20rpx 0 32rpx;
}

.tl-modal-footer-space {
  /* 为底部悬浮圆点留出可滚过的高度，避免末尾内容被遮挡 */
  height: 200rpx;
}

.status-card-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--md-sys-color-on-surface);
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge-pending {
  background: var(--md-sys-color-surface-variant);
  color: var(--md-sys-color-on-surface-variant);
}

.status-badge-active {
  background: #D1FAE5;
  color: #10B981;
}

.status-badge-ended {
  background: #E5E7EB;
  color: #6F767E;
}

.status-card-actions {
  display: flex;
  gap: 12rpx;
}

.status-card-footer {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #E5E7EB;
}

/* 状态卡片底部操作按钮已移至底部操作栏 */

.row-left { flex: 0 0 auto; min-width: 120rpx; display: flex; flex-direction: column; }
.row-label { font-size: 30rpx; font-weight: 600; color: var(--md-sys-color-on-surface); }
.row-right { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; }
.row-value { font-size: 26rpx; color: var(--md-sys-color-on-surface-variant); font-weight: 400; max-width: 520rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.split-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; justify-content: space-between; }
.split-half { width: 350rpx; flex-shrink: 0; min-width: 0; max-width: 350rpx; }
.split-half .panel { width: 350rpx; }
.panel-wide { width: 100% !important; }

.panel {
  background: var(--md-sys-color-surface);
  border-radius: var(--md-sys-shape-corner-medium);
  box-shadow: var(--md-sys-elevation-1);
  border: 1rpx solid #E5E7EB;
  overflow: hidden;
  box-sizing: border-box;
  height: 300rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  transition: all 0.2s;
}

.panel:active {
  border-color: var(--md-sys-color-primary);
  box-shadow: var(--md-sys-elevation-2);
  transform: scale(0.99);
}

.panel-header { padding: 16rpx 16rpx 10rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.panel-title { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; font-weight: 600; color: var(--md-sys-color-on-surface); }
.panel-hint { font-size: 22rpx; color: var(--md-sys-color-on-surface-variant); font-weight: 400; }
.panel-image { flex: 1; width: 100%; border-radius: 16rpx; margin: 0 16rpx 16rpx; }
.panel-body { padding: 0 16rpx 16rpx; }

.panel-map-wrap {
  position: relative;
  flex: 1;
  margin: 0 16rpx 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.panel-map-img { width: 100%; height: 100%; }
.panel-map-address-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 24rpx 14rpx 12rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.45) 45%, rgba(0, 0, 0, 0.72) 100%);
  pointer-events: none;
}
.panel-map-address-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: #fff;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.panel-map-empty { flex: 1; margin: 0 16rpx 16rpx; border-radius: 16rpx; background: var(--md-sys-color-surface-variant); border: 1rpx dashed #D1D5DB; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; }
.panel-map-empty-text { font-size: 24rpx; color: var(--md-sys-color-on-surface-variant); font-weight: 400; }

.fullscreen-popup { height: 100%; min-height: 100%; }
.popup-footer-full { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.member-quick-btn { position: absolute; top: 0rpx; right: 0rpx; width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3); border: 2rpx solid #ffffff; transition: all 0.2s; }
.member-quick-btn.plus { background: #10B981; }
.member-quick-btn.minus { background: #EF4444; box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.3); }
.member-quick-btn:active { transform: scale(0.9); }

.clamp-1, .clamp-2, .clamp-3 { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.clamp-1 { -webkit-line-clamp: 1; }
.clamp-2 { -webkit-line-clamp: 2; }
.clamp-3 { -webkit-line-clamp: 3; }

.mini-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 8rpx 0; }
.mini-k { font-size: 22rpx; color: var(--md-sys-color-on-surface-variant); }
.mini-v { font-size: 22rpx; color: var(--md-sys-color-on-surface); max-width: 210rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.muted { color: #9A9FA5; }

.legend { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--md-sys-color-on-surface-variant); }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot.joined { background: #10B981; }
.dot.clockin { background: #F59E0B; }
.dot.not { background: #D1D5DB; }

.moments-scroll { flex: 1; min-height: 0; height: 0; }
.moments-fab { position: absolute; bottom: 40rpx; right: 28rpx; z-index: 2000; }
.moments-fab-btn { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--md-sys-color-primary); box-shadow: 0 4rpx 12rpx rgba(223, 118, 176, 0.25); display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.moments-fab-btn:active { transform: scale(0.92); box-shadow: 0 8rpx 20rpx rgba(223, 118, 176, 0.3); }

.moment-preview { display: flex; gap: 12rpx; margin-top: 8rpx; flex: 1; min-height: 0; }
.moment-preview-img { width: 120rpx; height: 120rpx; border-radius: 14rpx; background: #eee; flex-shrink: 0; }
.moment-preview-body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 6rpx; }
.moment-preview-text { font-size: 24rpx; color: var(--md-sys-color-on-surface); line-height: 1.5; }
.moment-preview-meta { font-size: 22rpx; color: var(--md-sys-color-on-surface-variant); }

.member-grid-image-slot { display: flex; align-items: center; justify-content: center; overflow: visible; }
.members-grid-wrap { --td-grid-item-image-small-width: 92rpx; --td-grid-item-padding: 10rpx; --td-grid-item-text-padding-top: 10rpx; --td-grid-item-text-small-font-size: 22rpx; --td-grid-item-text-line-height: 34rpx; }
.member-avatar-trigger { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; position: relative; overflow: visible; }
.member-avatar { width: 92rpx; height: 92rpx; border-radius: 50%; box-sizing: border-box; border: 4rpx solid #D1D5DB; background: var(--md-sys-color-surface-variant); transition: all 0.2s; }
.member-avatar.status-joined { border-color: #10B981; }
.member-avatar.status-clockin { border-color: #F59E0B; }
.member-avatar.status-not { border-color: #D1D5DB; }

.member-expanded-header { display: flex; align-items: center; gap: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.member-avatar-large { width: 120rpx; height: 120rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.member-expanded-info { flex: 1; min-width: 0; }
.member-expanded-name-row { display: flex; align-items: center; gap: 12rpx; }
.member-expanded-name { font-size: 34rpx; font-weight: 600; color: var(--md-sys-color-on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.role-badge-large { padding: 6rpx 12rpx; border-radius: 12rpx; font-size: 22rpx; color: #fff; font-weight: 600; white-space: nowrap; }
.role-badge-large.member-role-president { background: var(--md-sys-color-primary); }
.role-badge-large.member-role-vice_president { background: #F59E0B; color: #fff; }
.role-badge-large.member-role-director { background: #3B82F6; }
.role-badge-large.member-role-member { background: #9A9FA5; }
.member-expanded-meta { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 12rpx; color: var(--md-sys-color-on-surface-variant); font-size: 24rpx; }
.detail-item { display: flex; align-items: center; gap: 8rpx; }
.member-expanded-details { padding-top: 6rpx; }
.member-detail-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid rgba(0, 0, 0, 0.06); }
.member-detail-row:last-child { border-bottom: none; }
.detail-label { font-size: 26rpx; color: var(--md-sys-color-on-surface-variant); }
.detail-value { font-size: 26rpx; color: var(--md-sys-color-on-surface); font-weight: 500; max-width: 420rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.popup-shell { padding: 24rpx; box-sizing: border-box; height: 100%; display: flex; flex-direction: column; position: relative; }
#card-members .popup-shell.fullscreen-popup, #card-moments .popup-shell.fullscreen-popup, #card-schedule .popup-shell.fullscreen-popup, #card-timeline .popup-shell.fullscreen-popup { padding: 0; }
#card-members .popup-body-full .popup-shell, #card-moments .popup-body-full .popup-shell, #card-schedule .popup-body-full .popup-shell, #card-timeline .popup-body-full .popup-shell { padding: 24rpx !important; }
.popup-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.popup-title { font-size: 32rpx; font-weight: 600; color: var(--md-sys-color-on-surface); }
.popup-body { flex: 1; overflow: visible; }
.popup-body-full { flex: 1; min-height: 0; height: 0; display: flex; flex-direction: column; overflow: hidden; }
.add-moment-scroll { flex: 1; min-height: 0; height: 0; }
.popup-footer { padding-top: 18rpx; }

.filters { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 0; padding: 0 24rpx; }
.filter-title { font-size: 32rpx; font-weight: 600; color: var(--md-sys-color-on-surface); }
.filter-right { display: flex; align-items: center; gap: 8rpx; background: var(--md-sys-color-surface-variant); padding: 10rpx 14rpx; border-radius: 999rpx; transition: all 0.2s; }
.filter-right:active { background: #E5E7EB; }
.filter-right-text { font-size: 24rpx; color: var(--md-sys-color-on-surface); font-weight: 500; max-width: 80rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-right.compact { flex: 0 0 auto; max-width: 140rpx; padding: 8rpx 10rpx; }

.mt-3 { margin-top: 24rpx; }
.mb-3 { margin-bottom: 24rpx; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 16rpx; margin-bottom: 16rpx; }
.calendar-cell { height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 28rpx; color: var(--md-sys-color-on-surface); background: var(--md-sys-color-surface-variant); border: 1rpx solid transparent; transition: all 0.2s; user-select: none; -webkit-tap-highlight-color: transparent; }
.calendar-cell.active { background: var(--md-sys-color-primary); color: #FFFFFF; border-color: var(--md-sys-color-primary); font-weight: 600; }
.week-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.week-cell { height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; font-size: 26rpx; color: var(--md-sys-color-on-surface-variant); background: var(--md-sys-color-surface-variant); border: 1rpx solid transparent; transition: all 0.2s; user-select: none; -webkit-tap-highlight-color: transparent; }
.week-cell.active { background: var(--md-sys-color-primary); color: #FFFFFF; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(223, 118, 176, 0.25); }

.publisher-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding-top: 12rpx; }
.publisher-item { width: 140rpx; display: flex; flex-direction: column; align-items: center; position: relative; padding: 8rpx 0; }
.publisher-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--md-sys-color-surface-variant); transition: all 0.2s; }
.publisher-avatar-active { box-sizing: border-box; border: 4rpx solid #10B981; }
.publisher-badge { position: absolute; top: 0; right: 14rpx; min-width: 36rpx; height: 36rpx; padding: 0 8rpx; border-radius: 18rpx; background: var(--md-sys-color-primary); color: #fff; font-size: 22rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; box-shadow: 0 2rpx 8rpx rgba(223, 118, 176, 0.25); }
.publisher-name { margin-top: 10rpx; font-size: 22rpx; color: var(--md-sys-color-on-surface-variant); width: 140rpx; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.moments-container { width: 100%; padding: 12rpx 24rpx; box-sizing: border-box; }
.moments-list { width: 100%; }
.moment-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); }
.moment-header { margin-bottom: 16rpx; }
.user-info { display: flex; align-items: center; position: relative; }
.user-details { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; }
.moment-item { background: var(--md-sys-color-surface); border-radius: 16rpx; padding: 24rpx; margin-bottom: 12rpx; border: 1rpx solid #E5E7EB; transition: all 0.2s; }
.moment-item:active { border-color: var(--md-sys-color-primary); }
.moment-ops { position: relative; padding: 8rpx; }
.moment-ops-menu { position: absolute; top: 100%; right: 0; background: white; border-radius: 8rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15); z-index: 100; min-width: 120rpx; }
.moment-ops-item { padding: 16rpx 24rpx; font-size: 28rpx; color: #333; text-align: center; border-bottom: 1rpx solid #f0f0f0; }
.moment-ops-item:last-child { border-bottom: none; }
.moment-content { margin-bottom: 16rpx; }
.username { font-size: 28rpx; font-weight: 600; color: var(--md-sys-color-on-surface); margin-bottom: 4rpx; }
.time { font-size: 24rpx; color: var(--md-sys-color-on-surface-variant); }
.moment-text { font-size: 28rpx; color: var(--md-sys-color-on-surface); line-height: 1.6; word-break: break-all; white-space: pre-wrap; }
.moment-images { margin-top: 16rpx; }
.images-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.empty-state { padding: 90rpx 0 60rpx; display: flex; flex-direction: column; align-items: center; }
.empty-text { margin-top: 24rpx; font-size: 30rpx; color: var(--md-sys-color-on-surface-variant); font-weight: 600; }
.empty-desc { margin-top: 12rpx; font-size: 24rpx; color: #9A9FA5; }
.empty-members { padding: 80rpx 0; text-align: center; }
.pill-ghost { background: var(--md-sys-color-surface-variant); color: var(--md-sys-color-on-surface); font-weight: 500; font-size: 26rpx; padding: 14rpx 20rpx; border-radius: 999rpx; transition: all 0.2s; }
.pill-ghost:active { background: #E5E7EB; }
.loading { margin-top: 120rpx; }
.members-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 32rpx; }
.members-toolbar .hint { font-size: 31rpx; color: var(--md-sys-color-on-surface-variant); }

/* 成员排序栏样式 */
.member-sort-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sort-option {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--md-sys-color-on-surface-variant);
  background: var(--md-sys-color-surface-variant);
  transition: all 0.2s;
  border: 1rpx solid transparent;
}

.sort-option.active {
  background: var(--md-sys-color-primary);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(223, 118, 176, 0.25);
}

.sort-option:active {
  transform: scale(0.96);
}

/* 分享按钮样式 */
.share-button {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  color: var(--md-sys-color-primary);
  background: transparent;
  border: 1rpx solid var(--md-sys-color-primary);
  border-radius: 12rpx;
  line-height: 1;
  transition: all 0.2s;
}

.share-button:active {
  background: var(--md-sys-color-primary-light);
}

.share-button::after {
  border: none;
}

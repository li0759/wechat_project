/* 协会管理骨架：对齐 club-manage-panel */

.sk-manage {
  width: 100%;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
  box-sizing: border-box;
  padding-top:40rpx;
}

.sk-rows {
  flex: 1;
  padding: 16rpx 16rpx 24rpx;
  box-sizing: border-box;
}

.sk-split-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-top:50rpx;
}

.sk-card,
.sk-panel {
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.sk-card {
  width: 350rpx;
  min-height: 100rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
}

.sk-card-head {
  flex-shrink: 0;
  min-width: 112rpx;
  display: flex;
  flex-direction: column;
}

.sk-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-top: 4rpx;
}

.sk-card-body--end {
  align-items: flex-end;
  justify-content: center;
}

.sk-panel {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sk-panel-post {
  width: 100%;
  height: 500rpx;
  padding: 18rpx 18rpx 16rpx;
  margin-bottom: 20rpx;
}

.sk-panel-half {
  width: 350rpx;
  height: 300rpx;
  padding: 18rpx 18rpx 16rpx;
}

.sk-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 12rpx;
}

.sk-post-preview-box {
  flex: 1;
  min-height: 0;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  background: #eceef2;
}

.sk-cover-preview {
  flex: 1;
  min-height: 0;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e8eaef 0%, #dfe3ea 100%);
}

.sk-mini-rows {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
  padding-top: 8rpx;
}

.sk-mini-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sk-footer-space {
  height: 120rpx;
}

.sk-bottom-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eceef2;
  box-sizing: border-box;
}

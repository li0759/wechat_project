/* 入会审批骨架：与 club-applications-panel 同一套 tl-modal-* 结构/样式 */

.cap-tl-root {
  --sk-gray-1: #eceef2;
  --sk-gray-2: #e2e5ea;
  --sk-gray-3: #d1d5db;
  --md-sys-color-on-surface: rgba(0, 0, 0, 0.88);
  --md-sys-color-on-surface-variant: rgba(0, 0, 0, 0.55);
}

.sk-tl-root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
  max-height: 100%;
  min-height: 0;
  overflow: hidden;
  background: #fff;
  box-sizing: border-box;
}

.tl-modal-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid #eceef2;
}

.tl-modal-h-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--md-sys-color-on-surface);
}

.tl-modal-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 8rpx 0 20rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  overflow: hidden;
}

.tl-modal-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.tl-modal-left {
  width: 112rpx;
  flex-shrink: 0;
  padding-right: 8rpx;
  box-sizing: border-box;
  text-align: right;
}

.tl-modal-rail {
  width: 36rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--sk-gray-3);
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
  margin-top: 6rpx;
}

.tl-vline {
  width: 2rpx;
  flex: 1;
  min-height: 36rpx;
  margin-top: 4rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.04) 100%);
  border-radius: 1rpx;
}

.tl-modal-main {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx 28rpx 4rpx;
  box-sizing: border-box;
}

.tl-modal-main--milestone-pending {
  background: linear-gradient(90deg, rgba(156, 163, 175, 0.14) 0%, rgba(156, 163, 175, 0.05) 52%, rgba(255, 255, 255, 0) 100%);
  border-left: 6rpx solid #9ca3af;
  border-right: 2rpx dashed rgba(156, 163, 175, 0.32);
  border-radius: 14rpx;
  padding: 18rpx 20rpx 22rpx 16rpx;
  margin-bottom: 8rpx;
}

.cap-app-pending-card {
  position: relative;
  box-sizing: border-box;
}

.cap-app-pending-actions {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.cap-app-pending-row {
  align-items: flex-start;
  width: 100%;
  margin-top: 12rpx;
}

.tl-op-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tl-modal-end-sk {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 32rpx;
}

.tl-modal-footer-space {
  height: 200rpx;
}

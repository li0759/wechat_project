.cmp-panel-root {
  height: 100%;
  min-height: 0;
  max-height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-top: 0;
  background-color: #f7f8fa;
  box-sizing: border-box;
}

.cmp-panel-root.cmp-panel-root--member-list {
  overflow: visible;
}

.members-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  margin-top: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #f7f8fa;
}

.cm-indexes-shell .cm-member-toolbar {
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.cm-filter-empty {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.cm-member-toolbar {
  flex-shrink: 0;
  padding: 0 24rpx 8rpx;
}

.cm-bulk-send-bar {
  width: 100%;
  min-height: 72rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
}

.cm-bulk-icon-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cm-bulk-icon-btn--hover {
  opacity: 0.72;
}

.cm-bulk-icon-btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

.cm-bulk-icon-btn--loading {
  opacity: 0.6;
  pointer-events: none;
}

.cm-bulk-send-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #1a1a1a;
  font-weight: 600;
  line-height: 1.35;
}

.cm-member-list-root {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.cm-tab-body-fill {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: visible;
}

.am-user-detail {
  position: relative;
  z-index: 10;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.am-detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
}

.am-detail-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.am-detail-main {
  flex: 1;
  min-width: 0;
}

.am-detail-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.am-detail-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.am-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  line-height: 1.2;
}

.am-tag-role {
  color: #666;
  background: rgba(0, 0, 0, 0.06);
}

.am-detail-kv {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.am-kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.am-kv:last-child {
  border-bottom: none;
}

.am-k {
  font-size: 26rpx;
  color: #999;
  font-weight: 700;
}

.am-v {
  font-size: 26rpx;
  color: #333;
  font-weight: 800;
  max-width: 420rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.am-detail-actions {
  padding-top: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.am-admin-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.am-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.am-btn-primary {
  background: rgba(102, 126, 234, 0.10);
  color: #667eea;
}

.am-btn-danger {
  background: rgba(255, 107, 157, 0.12);
  color: #ff6b9d;
}

.am-btn-hover {
  background: rgba(102, 126, 234, 0.18);
}

.am-btn-danger-hover {
  background: rgba(255, 107, 157, 0.22);
}

.member-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.member-meta-chip {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.member-position-chip {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.08);
}

.member-join-chip {
  color: #888;
  background: rgba(0, 0, 0, 0.04);
}

.member-role-chip {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* 下发到 club-event-indexes：参与明细区块 */
.cmb-member-activity {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
}

.cmb-member-activity__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cmb-member-activity__head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cmb-member-activity__export {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #fff0f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmb-member-activity__export--hover {
  opacity: 0.78;
}

.cmb-member-activity__export--loading {
  opacity: 0.55;
  pointer-events: none;
}

.cmb-member-activity__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
}

.cmb-member-activity__summary {
  font-size: 22rpx;
  color: #666;
}

.cmb-member-activity__loading,
.cmb-member-activity__empty {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0 4rpx;
}

.cmb-member-activity__list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cmb-member-activity__item {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
}

.cmb-member-activity__event {
  font-size: 26rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 8rpx;
}

.cmb-member-activity__line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 4rpx;
}

.cmb-member-activity__label {
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
}

.cmb-member-activity__value {
  font-size: 22rpx;
  color: #333;
  line-height: 1.4;
}

.cmb-member-activity__imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.cmb-member-activity__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: #eee;
}

.fab-container {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  z-index: 9500;
}

.fab-add {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgb(211, 211, 211);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.fab-add:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.6);
}

.nested-popup-shell {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
}

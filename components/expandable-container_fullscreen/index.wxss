/* components/expandable-container_fullscreen/index.wxss */

/* 容器包装器 - 简化版，不再需要变形动画 */
.expandable-wrapper {
  position: relative;
  display: inline-block;
  box-sizing: border-box;
}

.expandable-wrapper.full-size {
  display: block;
  width: 100%;
  height: 100%;
}

/* 触发内容 */
.trigger-content {
  display: inline-block;
  position: relative;
}

.trigger-content.full-size {
  display: block;
  width: 100%;
  height: 100%;
}

/* 涟漪遮罩 - 关键：确保可见 */
.fs-ripple {
  pointer-events: none;
  will-change: transform;
}

/* 不使用 root-portal 时的 fixed 定位样式 */
.fs-ripple-fixed {
  position: fixed;
}

/* 全屏 portal */
.fs-portal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

/* 不使用 root-portal 时的 fixed 定位样式 */
.fs-portal-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 全屏 sheet */
.fs-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  /* 默认白底；入场/离场/展开态由下方规则改为透明，白底由内层 .fs-sheet-content-bg 提供 */
  background: var(--fs-content-bg, #ffffff);
  overflow: visible;
  pointer-events: auto;
  transform: translateY(100%);
  opacity: 1;
}

/* 全屏内容区背景：覆盖在涟漪之上 */
.fs-sheet-content {
  position: relative;
  overflow: visible;
}

/* 背景层：负责白底与圆角，不裁切内容溢出 */
.fs-sheet-content-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--fs-content-bg, #ffffff);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  pointer-events: none;
}

/* 内容层：在背景之上（不设 z-index，避免子树层叠隔离导致嵌套全屏 fixed 无法盖住同祖先下的其它控件） */
.fs-sheet-content-body {
  position: relative;
  width: 100%;
  height: 100%;
}

.fs-content-slot-host {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

/* 被盖住：不 wx:if 卸载 slot（避免 slot 内仍有子全屏时被 opacity 继承隐藏），仅视觉与交互隐藏 */
.fs-content-slot-host.is-parked {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

/* page-container：勿用外层选择器当 div 来写样式（无效）。无遮罩/透明请用组件属性 overlay/custom-style（见 index.wxml） */

.fs-sheet.fs-enter-active {
  animation: fsSheetIn var(--fs-content-dur, 260ms) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  pointer-events: none;
  will-change: transform;
  /* 上滑入场全程：顶栏与 sheet 上方空隙露粉涟漪，与 fs-entered 一致 */
  background: transparent !important;
}

.fs-sheet.fs-leave-active {
  animation: fsSheetOut var(--fs-content-dur, 360ms) cubic-bezier(0.55, 0.055, 0.675, 0.19) forwards;
  pointer-events: none;
  will-change: transform;
  /* 下滑离场全程：与入场对称 */
  background: transparent !important;
}

.fs-sheet.fs-leave-linear {
  animation: fsSheetOut var(--fs-content-dur, 200ms) linear forwards;
  pointer-events: none;
  will-change: transform;
  background: transparent !important;
}

.fs-sheet.fs-entered {
  animation: none !important;
  transform: none !important;
  opacity: 1;
  pointer-events: auto;
  will-change: auto;
  /* 展开稳态：顶栏/返回键露粉涟漪；白底仅由内层 .fs-sheet-content-bg（--fs-top 起） */
  background: transparent !important;
}

.fs-sheet.fs-hidden {
  transform: translateY(100%);
  opacity: 1;
  pointer-events: none;
}

@keyframes fsSheetIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fsSheetOut {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

/* 被盖住时：骨架层铺满 sheet 内容区 */
.fs-parked-skeleton-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 500;
  overflow: hidden;
  background: #f7f8fa;
  border-radius: 30rpx 30rpx 0 0;
  box-sizing: border-box;
}

.fs-parked-skeleton-default {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 32rpx;
  box-sizing: border-box;
  z-index: 0;
}

.fs-parked-bar {
  height: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #eceef2 25%, #f5f6f8 50%, #eceef2 75%);
  background-size: 200% 100%;
  animation: fsParkedShimmer 1.2s ease-in-out infinite;
}

.fs-parked-bar--nav {
  width: 55%;
  height: 40rpx;
  margin-bottom: 40rpx;
}

.fs-parked-bar--hero {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.fs-parked-bar--short {
  width: 40%;
}

@keyframes fsParkedShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 返回按钮图标 */
.fullscreen-topbar-back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 6rpx solid #333;
  border-bottom: 6rpx solid #333;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

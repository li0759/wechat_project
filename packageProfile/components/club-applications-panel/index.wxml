<panel-loading-transition
  duration="280"
  command="{{pltCommand}}"
  auto-need-load="{{true}}"
  bind:needload="loadData"
  bind:loaded="onPanelLoadTransitionDone"
>
  <view slot="skeleton">
    <club-applications-skeleton />
  </view>
  <view slot="content">
<view class="cap-app-panel-host">
<view class="tl-modal-root cap-tl-root">
  <view class="tl-modal-header">
    <text class="tl-modal-h-title">入会审批</text>
    <text class="tl-modal-h-count" wx:if="{{applicationsTotalRecords > 0}}">共 {{applicationsTotalRecords}} 条</text>
  </view>

  <scroll-view
    class="tl-modal-scroll"
    scroll-y="{{true}}"
    show-scrollbar="{{false}}"
    enable-flex="{{true}}"
    lower-threshold="{{120}}"
    bindscrolltolower="onApplicationsScrollToLower"
  >
    <block wx:if="{{allApplications.length > 0}}">
      <view
        wx:for="{{allApplications}}"
        wx:key="applicationID"
        wx:for-index="idx"
        class="tl-modal-row"
      >
        <view class="tl-modal-left">
          <text class="tl-axis-date">{{item.axis_date}}</text>
          <text class="tl-axis-time">{{item.axis_time}}</text>
        </view>
        <view class="tl-modal-rail">
          <view class="tl-dot"></view>
          <view class="tl-vline" wx:if="{{idx < allApplications.length - 1}}"></view>
        </view>
        <view class="tl-modal-main {{item.mainClass}}">
          <block wx:if="{{item.processedDate}}">
            <text class="tl-milestone-title">{{item.approved ? '已批准' : '已拒绝'}}</text>
            <view class="tl-op-row">
              <image
                class="tl-op-avatar"
                src="{{item.appliced_user_avartor || defaultAvatarUrl}}"
                mode="aspectFill"
              />
              <view class="tl-op-meta">
                <text class="tl-op-name">{{item.appliced_user_name}}</text>
                <text class="tl-op-sub">申请时间 {{item.applicatedDate || '—'}}</text>
                <text class="tl-op-sub" wx:if="{{item.userProfileLine}}">{{item.userProfileLine}}</text>
                <text class="tl-op-sub">{{item.club_name || '协会'}} · 申请加入</text>
                <text class="tl-op-sub">处理人 {{item.processed_user_name || '—'}} · {{item.processedDate}}</text>
                <text wx:if="{{item.opinion}}" class="tl-op-sub">意见：{{item.opinion}}</text>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="cap-app-pending-card">
              <text class="tl-milestone-title tl-milestone-title--pending">待审批</text>
              <view class="tl-op-row cap-app-pending-row">
                <image
                  class="tl-op-avatar"
                  src="{{item.appliced_user_avartor || defaultAvatarUrl}}"
                  mode="aspectFill"
                />
                <view class="tl-op-meta">
                  <text class="tl-op-name">{{item.appliced_user_name}}</text>
                  <text class="tl-op-sub">申请时间 {{item.applicatedDate || '—'}}</text>
                  <text class="tl-op-sub" wx:if="{{item.userProfileLine}}">{{item.userProfileLine}}</text>
                  <text class="tl-op-sub">{{item.club_name || '协会'}} · 申请加入</text>
                </view>
              </view>
              <view class="cap-app-pending-actions" catchtap="stopBubble">
                <t-button
                  size="small"
                  theme="primary"
                  class="cap-btn cap-btn-approve"
                  data-application-id="{{item.applicationID}}"
                  bind:tap="showApproveDialog"
                >批准</t-button>
                <t-button
                  size="small"
                  theme="primary"
                  class="cap-btn cap-btn-reject"
                  data-application-id="{{item.applicationID}}"
                  bind:tap="showRejectDialog"
                >拒绝</t-button>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
    <view wx:else class="tl-modal-empty">
      <t-empty description="暂无申请记录" />
    </view>
    <view wx:if="{{applicationsListLoadingMore}}" class="tl-modal-loading">加载中…</view>
    <view wx:elif="{{applicationsListEnd && allApplications.length > 0}}" class="tl-modal-end">没有更多了</view>
    <view class="tl-modal-footer-space" />
  </scroll-view>
</view>

<t-dialog
  visible="{{ showApproveDialog }}"
  title="批准申请"
  confirm-btn="确定"
  cancel-btn="取消"
  bind:confirm="handleApprove"
  bind:close="closeDialog"
>
  <view slot="content" class="dialog-body">
    <textarea
      class="cap-dialog-textarea"
      value="{{ approveOpinion }}"
      placeholder="请输入批准意见（选填）"
      maxlength="200"
      auto-height
      bindinput="onApproveOpinionChange"
    />
    <text class="cap-dialog-counter">{{approveOpinion.length}}/200</text>
  </view>
</t-dialog>

<t-dialog
  visible="{{ showRejectDialog }}"
  title="拒绝申请"
  confirm-btn="确定"
  cancel-btn="取消"
  bind:confirm="handleReject"
  bind:close="closeDialog"
>
  <view slot="content" class="dialog-body">
    <textarea
      class="cap-dialog-textarea"
      value="{{ rejectOpinion }}"
      placeholder="请输入拒绝理由（必填）"
      maxlength="200"
      auto-height
      bindinput="onRejectOpinionChange"
    />
    <text class="cap-dialog-counter">{{rejectOpinion.length}}/200</text>
  </view>
</t-dialog>
</view>
  </view>
</panel-loading-transition>

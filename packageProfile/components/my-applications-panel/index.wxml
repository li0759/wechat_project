<panel-loading-transition
  duration="280"
  command="{{pltCommand}}"
  auto-need-load="{{true}}"
  bind:needload="loadData"
  bind:loaded="onPanelLoadTransitionDone"
>
  <view slot="skeleton">
    <my-applications-skeleton />
  </view>
  <view slot="content">
<view class="map-app-panel-host">
<view class="tl-modal-root map-tl-root">
  <view class="tl-modal-header">
    <text class="tl-modal-h-title">入会申请</text>
    <text class="tl-modal-h-count" wx:if="{{applications.length > 0}}">共 {{applications.length}} 条</text>
  </view>

  <scroll-view
    class="tl-modal-scroll"
    scroll-y="{{true}}"
    show-scrollbar="{{false}}"
    enable-flex="{{true}}"
  >
    <block wx:if="{{applications.length > 0}}">
      <view
        wx:for="{{applications}}"
        wx:key="applicationID"
        wx:for-index="idx"
        class="tl-modal-row"
      >
        <view class="tl-modal-left">
          <text class="tl-axis-date">{{item.axis_date}}</text>
          <text class="tl-axis-time">{{item.axis_time}}</text>
        </view>
        <view class="tl-modal-rail">
          <view class="tl-dot"></view>
          <view class="tl-vline" wx:if="{{idx < applications.length - 1}}"></view>
        </view>
        <view class="tl-modal-main {{item.mainClass}}">
          <view class="map-app-cover-bg" aria-hidden="true">
            <image
              class="map-app-cover-img"
              src="{{item.club_cover_thumb || defaultClubCoverUrl}}"
              mode="aspectFill"
            />
          </view>
          <block wx:if="{{item.processedDate}}">
            <view class="map-app-card-body">
              <text class="tl-milestone-title">{{item.approved ? '已批准' : '已拒绝'}}</text>
              <view class="tl-op-row">
                <view class="tl-op-meta">
                  <text class="tl-op-name">{{item.club_name}}</text>
                  <text class="tl-op-sub">申请时间 {{item.applicatedDate || '—'}}</text>
                  <text class="tl-op-sub">处理人 {{item.processed_user || '—'}} · {{item.processedDate}}</text>
                  <text wx:if="{{item.opinion}}" class="tl-op-sub">意见：{{item.opinion}}</text>
                </view>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="map-app-pending-card">
              <view class="map-app-pending-actions" catchtap="stopBubble">
                <t-button
                  size="small"
                  theme="primary"
                  class="map-btn map-btn-withdraw"
                  data-application-id="{{item.applicationID}}"
                  bind:tap="showWithdrawDialog"
                >撤回</t-button>
              </view>
              <view class="map-app-card-body">
                <text class="tl-milestone-title tl-milestone-title--pending">正在审批</text>
                <view class="tl-op-row map-app-pending-row">
                  <view class="tl-op-meta">
                    <text class="tl-op-name">{{item.club_name}}</text>
                    <text class="tl-op-sub">申请时间 {{item.applicatedDate || '—'}}</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
    <view wx:else class="tl-modal-empty">
      <t-empty description="暂无申请记录" />
    </view>
    <view class="tl-modal-footer-space" />
  </scroll-view>
</view>

<t-dialog
  visible="{{ withdrawDialogVisible }}"
  zIndex="200000"
  title="确认撤回申请"
  content="确定要撤回这个协会申请吗？撤回后无法恢复。"
  confirm-btn="确定撤回"
  cancel-btn="取消"
  bind:confirm="handleWithdraw"
  bind:close="closeDialog"
/>
</view>
  </view>
</panel-loading-transition>

<!-- 活动管理骨架：搜索 + 5 分组各 1 行 + 月索引侧栏 + FAB -->
<view class="sk-root sk-root--events">
  <view class="sk-main cm-indexes-shell">
    <view class="sk-toolbar cm-member-toolbar">
      <view class="sk-search">
        <t-skeleton
          animation="gradient"
          rowCol="{{[{ width: '100%', height: '72rpx', borderRadius: '999rpx' }]}}"
        />
      </view>
    </view>

    <view class="sk-list-root cm-member-list-root">
      <view class="sk-cmb">
        <view class="sk-cmb__body">
          <view class="sk-cmb__scroll">
            <block wx:for="{{branches}}" wx:key="anchor">
              <view class="sk-anchor">
                <view class="sk-anchor__header">{{item.anchor}}</view>
                <view class="sk-card sk-card--event">
                  <view class="sk-card__row">
                    <t-skeleton
                      animation="gradient"
                      rowCol="{{[{ width: '84rpx', height: '84rpx', borderRadius: '50%' }]}}"
                    />
                    <view class="sk-card__info">
                      <view class="sk-card__name-row">
                        <t-skeleton
                          animation="gradient"
                          rowCol="{{[{ width: '280rpx', height: '32rpx' }]}}"
                        />
                        <t-skeleton
                          animation="gradient"
                          rowCol="{{[{ width: '72rpx', height: '28rpx', borderRadius: '12rpx', marginLeft: '10rpx' }]}}"
                        />
                      </view>
                      <view class="sk-card__meta-row">
                        <t-skeleton
                          animation="gradient"
                          rowCol="{{[{ width: '240rpx', height: '32rpx', borderRadius: '8rpx' }]}}"
                        />
                      </view>
                      <view class="sk-card__meta-row sk-card__meta-row--loc">
                        <t-skeleton
                          animation="gradient"
                          rowCol="{{[{ width: '180rpx', height: '32rpx', borderRadius: '8rpx' }]}}"
                        />
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </view>

          <view class="sk-cmb__sidebar sk-cmb__sidebar--events">
            <view
              wx:for="{{branches}}"
              wx:key="sidebar"
              class="sk-cmb__sidebar-item {{item.sidebarActive ? 'sk-cmb__sidebar-item--active' : ''}}"
            >
              <text class="sk-cmb__sidebar-char">{{item.sidebar}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="sk-fab">
    <view class="sk-fab-btn">
      <text class="sk-fab-icon">+</text>
    </view>
  </view>
</view>
